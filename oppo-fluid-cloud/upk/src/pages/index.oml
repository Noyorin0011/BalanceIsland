<template>
  <card-template entry="notification" category="modular" onclick="openApp">
    <compact>
      <leading>
        <image level="A*" src="{{ $r('images.providerIcon') }}"></image>
      </leading>
      <trailing>
        <text level="B*">{{ compactValue }}</text>
      </trailing>
    </compact>
    <expanded level="F1*">
      <leading>
        <text level="B1*">{{ providerName }}</text>
      </leading>
      <center category="text-highlight">
        <text level="B1*">{{ primaryText }}</text>
        <text level="C2">{{ secondaryText }}</text>
      </center>
      <trailing>
        <text level="E9*">{{ updatedText }}</text>
      </trailing>
    </expanded>
    <image level="A1*" src="assets/images/service_icon.png"></image>
  </card-template>
</template>

<data>
{
  "uiData": {
    "providerIcon": "assets/images/service_icon.png",
    "compactValue": "--",
    "providerName": "API 余额",
    "primaryText": "等待更新",
    "secondaryText": "打开应用完成配置",
    "updatedText": "刚刚"
  },
  "uiEvent": {
    "openApp": {
      "type": "deeplink",
      "package": "com.noyorin.balanceisland",
      "uri": "balanceisland://open"
    }
  }
}
</data>
